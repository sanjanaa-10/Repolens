# RepoLens environment configuration.
# Copy to `.env`, `backend/.env`, or export in your shell as needed. All
# variables are optional — the defaults below are used when variable is absent.
# NEVER commit `.env` files; `backend/.env` is never read into any artifact.

# --- Backend ---
REPOLENS_DEBUG=true
REPOLENS_APP_NAME=RepoLens
REPOLENS_VERSION=0.1.0

# Runtime storage (SQLite + cloned repositories)
REPOLENS_REPO_STORAGE_DIR=./data/repositories
REPOLENS_DB_PATH=./data/repolens.db

# Security / resource limits for untrusted repository input
REPOLENS_CLONE_TIMEOUT_SECONDS=120
REPOLENS_MAX_FILE_SIZE_BYTES=524288
REPOLENS_MAX_FILES_PER_REPO=10000
REPOLENS_MAX_REPO_SIZE_BYTES=209715200

# Trusted hosts (TrustedHostMiddleware allowlist).
# Local development defaults are fine; a deployment behind a reverse proxy
# MUST list its public hostnames here, comma-separated, e.g.:
# REPOLENS_TRUSTED_HOSTS=repolens.example.com,localhost,127.0.0.1
REPOLENS_TRUSTED_HOSTS=localhost,127.0.0.1

# --- Optional AI layer (Lens AI) ---
# If unset, RepoLens still works: the deterministic core is LLM-independent.
# The AI layer only ever receives evidence-selected snippets, never whole repos.
#REPOLENS_AI_PROVIDER=openai
#REPOLENS_AI_API_KEY=sk-...
#REPOLENS_AI_MODEL=gpt-4o-mini
#REPOLENS_AI_BASE_URL=https://api.openai.com/v1   # OpenAI-compatible override

# Lens budget / robustness bounds (Phase 9 hard caps)
REPOLENS_LENS_TIMEOUT_SECONDS=20
REPOLENS_LENS_MAX_CONTEXT_CHARS=12000
REPOLENS_LENS_MAX_SOURCE_SNIPPET_CHARS=800
REPOLENS_LENS_MAX_IMPACT_PATHS_IN_CONTEXT=6
REPOLENS_LENS_PROMPT_VERSION=1