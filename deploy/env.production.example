# RepoLens production environment template.
#
# Copy to backend/.env on the deployment host and (a MUST for production) set
# REPOLENS_TRUSTED_HOSTS to the exact public hostnames served by your reverse
# proxy. TrustedHostMiddleware rejects any other Host header.
#
# This file is committed as a template only. The real backend/.env is secret-
# adjacent and is never read into any repository artifact.

# --- Backend ---
# Debug MUST be false in production: it flips log level and changes error
# behavior. Real deployments bind the backend to 127.0.0.1 behind a proxy.
REPOLENS_DEBUG=false
REPOLENS_APP_NAME=RepoLens
REPOLENS_VERSION=0.1.0

# Runtime storage (SQLite + cloned repositories). Keep these on persistent,
# backed-up storage and outside the repo working tree.
REPOLENS_REPO_STORAGE_DIR=/srv/repolens/data/repositories
REPOLENS_DB_PATH=/srv/repolens/data/repolens.db

# Resource limits for untrusted repository input (keep the sane defaults).
REPOLENS_CLONE_TIMEOUT_SECONDS=120
REPOLENS_MAX_FILE_SIZE_BYTES=524288
REPOLENS_MAX_FILES_PER_REPO=10000
REPOLENS_MAX_REPO_SIZE_BYTES=209715200

# Trusted hosts. MUST list the public hostnames served by your proxy, e.g.:
#   REPOLENS_TRUSTED_HOSTS=repolens.example.com,localhost,127.0.0.1
REPOLENS_TRUSTED_HOSTS=repolens.example.com,localhost,127.0.0.1

# --- Optional AI layer (Lens AI) ---
# The deterministic core is LLM-independent. If you enable Lens, keep the key
# here (never commit it, never paste it into a repository being analyzed).
#REPOLENS_AI_PROVIDER=openai
#REPOLENS_AI_API_KEY=sk-...
#REPOLENS_AI_MODEL=gpt-4o-mini
#REPOLENS_AI_BASE_URL=https://api.openai.com/v1

# Lens budget / robustness bounds.
REPOLENS_LENS_TIMEOUT_SECONDS=20
REPOLENS_LENS_MAX_CONTEXT_CHARS=12000
REPOLENS_LENS_MAX_SOURCE_SNIPPET_CHARS=800
REPOLENS_LENS_MAX_IMPACT_PATHS_IN_CONTEXT=6
REPOLENS_LENS_PROMPT_VERSION=1